{
  "name": "Challenge",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "title_ar": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_ar": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "steps",
        "exercise",
        "water",
        "streak",
        "custom"
      ]
    },
    "target_value": {
      "type": "number"
    },
    "current_value": {
      "type": "number",
      "default": 0
    },
    "reward_xp": {
      "type": "number",
      "default": 50
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "expired"
      ],
      "default": "active"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "badge_icon": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "title"
  ]
}
