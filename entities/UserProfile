{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "full_name": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "height_cm": {
      "type": "number"
    },
    "weight_kg": {
      "type": "number"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "goal": {
      "type": "string",
      "enum": [
        "lose_weight",
        "build_muscle",
        "improve_fitness",
        "maintain_health"
      ]
    },
    "activity_level": {
      "type": "string",
      "enum": [
        "sedentary",
        "light",
        "moderate",
        "active",
        "very_active"
      ]
    },
    "daily_step_goal": {
      "type": "number",
      "default": 5000
    },
    "profile_bg_url": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ],
      "default": "ar"
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "onboarding_done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email"
  ]
}
